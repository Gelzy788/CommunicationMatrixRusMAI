# Переменные для docker compose (этот файл копируется в .env в корне репозитория).
# Секреты бэка и БД лежат отдельно, в backend/.env.

# На какой адрес и порт публиковать nginx приложения.
# Ставь IP интерфейса, до которого достаёт NPM (например, IP виртуалки в локалке),
# а не 0.0.0.0. Если NPM на этой же машине, хватит 127.0.0.1.
NGINX_BIND=127.0.0.1
NGINX_PORT=8081

# server_name в конфиге nginx. "_" = любой домен.
NGINX_SERVER_NAME=_

# Максимальный размер тела запроса (загрузки и т.п.)
NGINX_CLIENT_MAX_BODY_SIZE=10m
