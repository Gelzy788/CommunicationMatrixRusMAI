        {
          "name": "Получить CSRF",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"CSRF request successful\", () => {\n    pm.response.to.have.status(200);\n});\n\nconst response = pm.response.json();\n\npm.test(\"CSRF token exists\", () => {\n    pm.expect(response.csrfToken).to.be.a(\"string\");\n    pm.expect(response.csrfToken).to.not.be.empty;\n});\n\npm.collectionVariables.set(\n    \"csrfToken\",\n    response.csrfToken\n);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/csrf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "csrf"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Регистрация — успех",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\npm.test(\"HTTP 201\", () => {\n    pm.response.to.have.status(201);\n});\n\nconst response = pm.response.json();\n\npm.test(\"Поля пользователя\", () => {\n    const user = response.user || response;\n\n    ['id', 'email', 'fullName'].forEach((key) => {\n        pm.expect(user).to.have.property(key);\n    });\n\n    pm.expect(user.email).to.be.a(\"string\");\n});\n"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "{{csrfHeader}}",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"fullName\": \"{{fullName}}\",\n  \"consentAccepted\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
